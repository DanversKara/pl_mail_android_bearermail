<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The product's name, not a word. It reads the same in every locale. -->
    <string name="app_name" translatable="false">BearerMail</string>

    <!--
      What the calendar's own launcher icon is called, when the user has asked
      for one. Translatable, unlike app_name, because half of it is a word: the
      product's name stays put and "Calendar" is the part a German home screen
      has to say in German. Kept short on purpose; a launcher gives a label
      about twelve characters before it ellipsises.
    -->
    <string name="calendar_app_name">BearerMail Calendar</string>
    <string name="share_to_drive">BearerMail Drive</string>
    <!-- BearerMail: updates from GitHub Releases -->
    <string name="update_title">BearerMail %1$s is available</string>
    <string name="update_body">Version %1$s (%2$s) is ready. Download it and install it now? Your mail and settings stay as they are.</string>
    <string name="update_now">Update</string>
    <string name="update_later">Later</string>
    <string name="update_skip">Skip this version</string>
    <string name="update_downloading">Downloading %1$s…</string>
    <string name="update_permission_title">Allow BearerMail to install updates</string>
    <string name="update_permission_body">Android asks once whether BearerMail may install apps. Switch on \"Allow from this source\", then come back and the update continues.</string>
    <string name="update_permission_open">Open settings</string>
    <string name="update_failed">Update failed</string>
    <string name="update_failed_body">The update could not be downloaded or installed. Try again, or download it from the release page.</string>
    <string name="update_failed_signature">This update is signed with a different key than the installed app. Uninstall BearerMail and install the release APK once by hand.</string>
    <string name="update_retry">Try again</string>
    <string name="update_open_page">Release page</string>
    <!-- BearerMail: app lock -->
    <string name="lock_title">BearerMail is locked</string>
    <string name="lock_enter">Enter your %1$d-digit PIN</string>
    <string name="lock_wrong">Wrong PIN. Try again.</string>
    <plurals name="lock_wait">
        <item quantity="one">Too many wrong PINs. Try again in %1$d second.</item>
        <item quantity="other">Too many wrong PINs. Try again in %1$d seconds.</item>
    </plurals>
    <string name="lock_forgot">Forgot your PIN? Clear BearerMail\'s storage in Android Settings → Apps, then pair again.</string>
    <string name="lock_dots">Digits entered: %1$d of %2$d</string>
    <string name="lock_delete">Delete</string>
    <string name="lock_back">Back</string>
    <string name="lock_settings_title">App lock</string>
    <string name="lock_explain">Ask for a PIN every time BearerMail opens, so someone holding your unlocked phone cannot read your mail. Notifications still show on the lock screen; turn off previews in Android\'s notification settings if you want them hidden too.</string>
    <string name="lock_turn_on">Set a PIN</string>
    <string name="lock_is_on">App lock is on (%1$d-digit PIN)</string>
    <string name="lock_grace_title">Lock again after leaving the app</string>
    <string name="lock_grace_now">Immediately</string>
    <string name="lock_grace_1">After 1 minute</string>
    <string name="lock_grace_5">After 5 minutes</string>
    <string name="lock_change">Change PIN</string>
    <string name="lock_turn_off">Turn off app lock</string>
    <string name="lock_choose_length">How long should the PIN be?</string>
    <string name="lock_digits">%1$d-digit PIN</string>
    <string name="lock_new_pin">Enter a new %1$d-digit PIN</string>
    <string name="lock_confirm_pin">Enter the same PIN again</string>
    <string name="lock_mismatch">The PINs did not match. Enter it again.</string>
    <string name="lock_current_pin">Enter your current PIN</string>
    <string name="update_checking">Checking for updates…</string>
    <string name="update_check_failed">Could not reach GitHub to check for updates. Try again when you are online.</string>
    <string name="update_up_to_date">BearerMail %1$s is up to date.</string>
    <!-- BearerMail: crash report -->
    <string name="crash_title">BearerMail closed unexpectedly</string>
    <string name="crash_copy">Copy</string>
    <string name="crash_dismiss">Dismiss</string>
    <!-- Home-screen calendar widgets -->
    <string name="calendar_month_widget_label">Calendar month</string>
    <string name="calendar_month_widget_description">Month grid with your events</string>
    <string name="calendar_agenda_widget_label">Calendar agenda</string>
    <string name="calendar_agenda_widget_description">Upcoming events, soonest first</string>
    <string name="calendar_widget_empty">Nothing coming up</string>
    <string name="calendar_widget_all_day">All day</string>
